{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests/unit"
  ],
  "editor.rulers": [
    88
  ],
  "files.eol": "\n",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[yaml]": {
    "editor.tabSize": 2
  },
  "[makefile]": {
    "editor.insertSpaces": false
  },
  "ruff.importStrategy": "fromEnvironment",
  "mypy-type-checker.path": [
    "${workspaceFolder}/.venv/bin/mypy"
  ],
  "mypy-type-checker.interpreter": [
    "${workspaceFolder}/.venv/bin/python"
  ],
  "mypy-type-checker.cwd": "${workspaceFolder}",
  "mypy-type-checker.args": [
    "--config-file=${workspaceFolder}/pyproject.toml"
  ],
  "mypy-type-checker.reportingScope": "custom",
  "shellcheck.executablePath": "${workspaceFolder}/.venv/bin/shellcheck",
  "shellcheck.useWorkspaceRootAsCwd": true,
  "python.languageServer": "Pylance",
  "cSpell.language": "en,uk",
  "cSpell.useGitignore": true,
  "cSpell.ignorePaths": [
    "uv.lock"
  ],
  "[json]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.rulers": [
      100
    ]
  },
  "editor.detectIndentation": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[jsonc]": {
    "editor.tabSize": 2
  }
}
