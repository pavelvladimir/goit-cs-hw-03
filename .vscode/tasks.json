{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make init",
      "type": "process",
      "command": "make",
      "args": [
        "init"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "make check-unit",
      "type": "process",
      "command": "make",
      "args": [
        "check-unit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "ruff",
          "source": "Ruff",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.*):(\\d+):(\\d+): ([A-Z]+\\d+) (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          },
          "severity": "error"
        },
        {
          "owner": "mypy",
          "source": "mypy",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.*):(\\d+):(\\d+): (error|warning|note): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        },
        {
          "owner": "pymarkdown",
          "source": "PyMarkdown",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.*):(\\d+):(\\d+): (MD\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          },
          "severity": "error"
        },
        "$gcc"
      ]
    },
